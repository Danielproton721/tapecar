# Gateway de pagamento: Beehive Pay — defina na Vercel (Settings → Env Variables).
# Enquanto as chaves estiverem vazias, o checkout renderiza mas mostra
# "gateway não configurado" ao tentar pagar. Nada de chave no código.

# Chave PÚBLICA da Beehive (vai pro cliente — pode ser pública). Sem ela o
# checkout do front nem liga (precisa dela pra tokenizar cartão).
PAYMENT_PUBLIC_KEY=

# Chave SECRETA da Beehive — usada SÓ no servidor (app/api/payment/create via
# lib/beehive.js). NUNCA prefixe com NEXT_PUBLIC_ e NUNCA mande pro cliente.
PAYMENT_SECRET_KEY=

# "beehive" (padrão). Deixe assim a não ser que troque de gateway.
PAYMENT_GATEWAY=beehive

# "production" (padrão) ou "sandbox" (ambiente de testes da Beehive/hopysplit).
PAYMENT_ENV=production

# Domínio da loja — usado no metadata obrigatório da Beehive (shop_url/checkout_url).
# Se vazio, cai no host do request. Ex.: https://tapecar.shop
SITE_URL=

# Nome curto da loja no metadata da transação (padrão "tapecar").
PAYMENT_PROVIDER=tapecar

# Opcional: URL que recebe os webhooks de mudança de status da Beehive (postbackUrl).
# Sem ela, o PIX não confirma sozinho — implemente /api/payment/webhook depois.
PAYMENT_WEBHOOK_URL=

# Opcionais — só se quiser sobrescrever os padrões do SDK client-side:
# PAYMENT_SDK_URL=https://api.conta.paybeehive.com.br/v1/js
# PAYMENT_SDK_GLOBAL=BeehivePay
# PAYMENT_TEST_MODE=false

# Pixel do TikTok — hoje vazio em public/js/tiktok-pixel.js (o do dono foi removido).
# Cole o SEU id lá e ajuste HOSTS_PRODUCAO pro seu domínio.
