# Gateway de pagamento — defina na Vercel (Settings → Environment Variables).
# Enquanto PAYMENT_PUBLIC_KEY estiver vazia, o checkout renderiza mas mostra
# "gateway não configurado" ao tentar pagar.

# Chave PÚBLICA do gateway (vai pro cliente — pode ser pública).
PAYMENT_PUBLIC_KEY=

# "beehive" ou "payout".
PAYMENT_GATEWAY=beehive

# Opcionais — só se quiser sobrescrever os padrões do gateway:
# PAYMENT_SDK_URL=https://api.conta.paybeehive.com.br/v1/js
# PAYMENT_SDK_GLOBAL=BeehivePay
# PAYMENT_TEST_MODE=false

# Chave SECRETA do gateway — usada SÓ no servidor, em app/api/payment/create.
# NUNCA prefixe com NEXT_PUBLIC_ e NUNCA mande pro cliente.
# PAYMENT_SECRET_KEY=

# Pixel do TikTok — hoje está vazio no public/js/tiktok-pixel.js (o do dono
# original foi removido). Cole o SEU id lá e ajuste HOSTS_PRODUCAO pro seu domínio.
